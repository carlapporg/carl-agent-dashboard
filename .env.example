# Reference env file for new developers. Copy to .env.staging / .env.production.
#
# Loaded automatically:
#   npm run dev   → .env.staging
#   npm run build → .env.production
#   npm run start → .env.production
#
# Include /api/v1 on the host. API path routes live in code:
#   lib/api/endpoints.ts

API_BASE_URL=https://YOUR-API-HOST/api/v1
API_DOCS_URL=https://YOUR-API-HOST/api/docs

# Native WebSocket (browser WebSocket API — not Socket.IO).
# Example: wss://YOUR-API-HOST/ws
# If unset, the client derives ws(s)://host/ws from API_BASE_URL.
# NEXT_PUBLIC_WS_URL=wss://YOUR-API-HOST/ws

# AUTH_STUB_MODE=true
# NEXT_PUBLIC_API_BASE_URL=
#abc