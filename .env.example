# Reference env file for new developers. Copy to .env.staging / .env.production.
#
# Loaded automatically:
#   npm run dev   → .env.staging
#   npm run build → .env.production
#   npm run start → .env.production
#
# Include /api/v1 on the host. Paths below must NOT repeat /api/v1.

API_BASE_URL=https://YOUR-API-HOST/api/v1
API_DOCS_URL=https://YOUR-API-HOST/api/docs

# AUTH_STUB_MODE=true
# NEXT_PUBLIC_API_BASE_URL=

# Live Agent APIs only (joined with API_BASE_URL)
API_AUTH_AGENT_LOGIN=/auth/agent/login
API_AGENTS_ME=/agents/me
API_AGENTS_CHANGE_PASSWORD=/agents/me/change-password
