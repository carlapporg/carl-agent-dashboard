# Reference env file for new developers. Copy to .env.staging / .env.production.
#
# Loaded automatically:
#   npm run dev   → .env.staging
#   npm run build → .env.production
#   npm run start → .env.production
#
# These files are gitignored. Pushing to GitHub does NOT deploy them.
# For Vercel: Project → Settings → Environment Variables → set:
#   API_BASE_URL=https://carl.rankorbit.dev/api/v1
#   API_DOCS_URL=https://carl.rankorbit.dev/api/docs
#   NEXT_PUBLIC_SOCKET_URL=https://carl.rankorbit.dev
#   NEXT_PUBLIC_API_BASE_URL=https://carl.rankorbit.dev/api/v1
# Then Redeploy.
#
# Include /api/v1 on the host. API path routes live in code:
#   lib/api/endpoints.ts

API_BASE_URL=https://carl.rankorbit.dev/api/v1
API_DOCS_URL=https://carl.rankorbit.dev/api/docs
NEXT_PUBLIC_SOCKET_URL=https://carl.rankorbit.dev
NEXT_PUBLIC_API_BASE_URL=https://carl.rankorbit.dev/api/v1

# AUTH_STUB_MODE=true
