# Reference env file for new developers. Copy to .env.staging / .env.production.
#
# Loaded automatically:
#   npm run dev   → .env.staging
#   npm run build → .env.production
#   npm run start → .env.production
#
# These files are gitignored. Pushing to GitHub does NOT deploy them.
# For Vercel: Project → Settings → Environment Variables → set:
#   API_BASE_URL=http://YOUR-API-HOST/api/v1
#   API_DOCS_URL=http://YOUR-API-HOST/api/docs
#   NEXT_PUBLIC_SOCKET_URL=http://YOUR-API-HOST
# Then Redeploy.
# Temporary (no HTTPS on Nest yet): the app proxies /socket.io through Vercel
# so the browser stays on HTTPS. Nest must allow Vercel outbound IPs.
#
# Include /api/v1 on the host. API path routes live in code:
#   lib/api/endpoints.ts

API_BASE_URL=https://YOUR-API-HOST/api/v1
API_DOCS_URL=https://YOUR-API-HOST/api/docs

# Socket.IO origin (no /api/v1). Example: http://localhost:4000
# If unset, derived from API_BASE_URL by stripping /api/v1.
# NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# AUTH_STUB_MODE=true
# NEXT_PUBLIC_API_BASE_URL=